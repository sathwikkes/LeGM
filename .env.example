# API server (uv run legm serve)
LEGM_SECRET_KEY=change-me-to-a-long-random-string      # JWT signing secret; required before sharing
LEGM_TOKEN_TTL_HOURS=168
LEGM_INVITE_CODE=                                     # set to require an invite code at sign-up
LEGM_DATABASE_URL=sqlite:///data/legm.db              # or postgresql+psycopg://...
LEGM_CORS_ORIGINS=http://localhost:3000                # comma-separated, no trailing slashes
LEGM_CORS_ORIGIN_REGEX=                               # optional, e.g. https://.*\.vercel\.app for preview deploys
ANTHROPIC_API_KEY=                                    # enables the draft assistant; leave empty to run without it
LEGM_LLM_MODEL=claude-opus-5

# Web (web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
